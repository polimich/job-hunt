{
  "name": "job-hunt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch --ignore './data/**' server/index.ts\" \"vite\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "refresh": "tsx server/cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@lucide/vue": "^1.73.0",
    "@vueuse/core": "^15.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "hono": "^4.13.19",
    "markdown-it": "^14.3.3",
    "minisearch": "^7.2.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
