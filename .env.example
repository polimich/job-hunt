# Copy to .env and fill in. .env is not in git.
# Careerjet partner key: https://www.careerjet.cz/partners/api
CAREERJET_KEY=
# Optional: your public IP for Careerjet's required user_ip parameter
CAREERJET_USER_IP=
# Jooble key: https://jooble.org/api/about
JOOBLE_KEY=
# Gmail (send from the app, read job mail). OAuth "Desktop app" client from Google Cloud;
# setup steps in README → Gmail. The sign-in token itself goes to the macOS Keychain, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
